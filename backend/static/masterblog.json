{
  "swagger": "2.0",
  "info": {
    "title": "Masterblog API",
    "version": "1.0.0"
  },
  "host": "localhost:5002",
  "schemes": [
    "http"
  ],
  "tags": [
    {
      "name": "Post",
      "description": "Post API - CRUD"
    }
  ],
  "paths": {
    "/api/posts": {
      "get": {
        "summary": "Returns all posts",
        "produces": [
          "application/json"
        ],
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "type": "string",
            "enum": [
              "title",
              "content",
              "author",
              "date"
            ],
            "required": false,
            "description": "Field to sort by"
          },
          {
            "name": "direction",
            "in": "query",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "required": false,
            "description": "Sort direction"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Post"
              }
            }
          },
          "400": {
            "description": "Invalid sort field or direction"
          }
        }
      },
      "post": {
        "summary": "Create a new post",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "post",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PostInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Post successfully created",
            "schema": {
              "$ref": "#/definitions/Post"
            }
          },
          "400": {
            "description": "Missing required fields or invalid date format"
          }
        }
      }
    },
    "/api/posts/search": {
      "get": {
        "summary": "Search posts",
        "produces": [
          "application/json"
        ],
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "Search term. Searches in title, content, author and date."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Post"
              }
            }
          }
        }
      }
    },
    "/api/posts/{id}": {
      "put": {
        "summary": "Update an existing post",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of the post"
          },
          {
            "name": "post",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PostUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post successfully updated",
            "schema": {
              "$ref": "#/definitions/Post"
            }
          },
          "400": {
            "description": "Invalid date format"
          },
          "404": {
            "description": "Post not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a post",
        "produces": [
          "application/json"
        ],
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of the post"
          }
        ],
        "responses": {
          "200": {
            "description": "Post successfully deleted"
          },
          "404": {
            "description": "Post not found"
          }
        }
      }
    }
  },
  "definitions": {
    "Post": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "example": 1
        },
        "title": {
          "type": "string",
          "example": "My First Blog Post"
        },
        "content": {
          "type": "string",
          "example": "This is the content of my first blog post."
        },
        "author": {
          "type": "string",
          "example": "Max"
        },
        "date": {
          "type": "string",
          "format": "date",
          "example": "2026-09-27"
        }
      }
    },
    "PostInput": {
      "type": "object",
      "required": [
        "title",
        "content",
        "author",
        "date"
      ],
      "properties": {
        "title": {
          "type": "string",
          "example": "My new post"
        },
        "content": {
          "type": "string",
          "example": "This is the content of my new post."
        },
        "author": {
          "type": "string",
          "example": "Max"
        },
        "date": {
          "type": "string",
          "format": "date",
          "example": "2026-09-29"
        }
      }
    },
    "PostUpdate": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Updated title"
        },
        "content": {
          "type": "string",
          "example": "Updated content."
        },
        "author": {
          "type": "string",
          "example": "Anna"
        },
        "date": {
          "type": "string",
          "format": "date",
          "example": "2026-09-30"
        }
      }
    }
  }
}